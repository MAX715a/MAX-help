for _, Point in ipairs(Waypoints) do
    local Dist = (Root.Position - Point).Magnitude
    local Tween = TweenService:Create(Root, TweenInfo.new(Dist / 400, Enum.EasingStyle.Linear), {CFrame = CFrame.new(Point)})
    Tween:Play()
    Tween.Completed:Wait()
end
